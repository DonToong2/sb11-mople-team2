{
  "family": "mople-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID_PLACEHOLDER:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "mople-app",
      "image": "PLACEHOLDER",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mople-app-task",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/DB_PASSWORD" },
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/DB_USERNAME" },
        { "name": "REDIS_PASSWORD", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/REDIS_PASSWORD" },
        { "name": "AWS_S3_ACCESS_KEY_ID", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/AWS_S3_ACCESS_KEY_ID" },
        { "name": "AWS_S3_SECRET_ACCESS_KEY", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/AWS_S3_SECRET_ACCESS_KEY" },
        { "name": "GOOGLE_CLIENT_ID", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/GOOGLE_CLIENT_ID" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/GOOGLE_CLIENT_SECRET" },
        { "name": "KAKAO_CLIENT_ID", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/KAKAO_CLIENT_ID" },
        { "name": "KAKAO_CLIENT_SECRET", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/KAKAO_CLIENT_SECRET" },
        { "name": "BREVO_SMTP_USERNAME", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/BREVO_SMTP_USERNAME" },
        { "name": "BREVO_SMTP_PASSWORD", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/BREVO_SMTP_PASSWORD" },
        { "name": "JWT_SECRET", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/JWT_SECRET" },
        { "name": "TMDB_API_KEY", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/TMDB_API_KEY" },
        { "name": "SPORTSDB_API_KEY", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/SPORTSDB_API_KEY" },
        { "name": "ADMIN_PASSWORD", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/ADMIN_PASSWORD" },
        { "name": "ELASTIC_USERNAME", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/ELASTIC_USERNAME" },
        { "name": "ELASTIC_PASSWORD", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/ELASTIC_PASSWORD" },
        { "name": "DISCORD_WEBHOOK_URL", "valueFrom": "arn:aws:ssm:ap-northeast-2:ACCOUNT_ID_PLACEHOLDER:parameter/mople/DISCORD_WEBHOOK_URL" }
      ]
    }
  ]
}
